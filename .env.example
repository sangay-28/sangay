PORT=3000
# PostgreSQL connection string (create the database in pgAdmin first).
DATABASE_URL=postgresql://clubs_app:CHANGE_ME@localhost:5432/sherubtse_clubs
# Source database used only by `npm run migrate:sqlite`.
DATABASE_PATH=./data/clubs.sqlite
PGSSL=false
# Set a unique administrator account before using /admin.html.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Configure SMTP to deliver one-time sign-in and signup codes. Gmail uses an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
# Optional HTTPS email delivery for Render Free (takes precedence over SMTP).
# Use onboarding@resend.dev for testing, or a sender on a domain verified with Resend.
RESEND_API_KEY=
RESEND_FROM=
# Generate a long random value and keep it stable across server restarts.
OTP_SECRET=generate-a-long-random-secret
