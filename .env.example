PORT=3000
# PostgreSQL connection string (create the database in pgAdmin first).
DATABASE_URL=postgresql://clubs_app:CHANGE_ME@localhost:5432/sherubtse_clubs
# Source database used only by `npm run migrate:sqlite`.
DATABASE_PATH=./data/clubs.sqlite
PGSSL=false
# Set a unique administrator account before using /admin.html.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Generate a long random value and keep it stable across server restarts.
OTP_SECRET=generate-a-long-random-secret
# Gmail SMTP: use a dedicated sender account and its Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
